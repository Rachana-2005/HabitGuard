rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile: Only authenticated user can read or write their profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Daily Usage Subcollection
      match /dailyUsage/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Applications Subcollection
        match /applications/{packageName} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
      
      // Registered FCM Devices
      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // High-Risk Alert Logs (Readable by user; created by user / backend)
      match /alerts/{alertId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false; // Immutable audit log
      }
    }
  }
}
